state.ES8388 {
	control.1 {
		iface MIXER
		name 'Capture Digital Volume'
		value.0 192
		value.1 192
		comment {
			access 'read write'
			type INTEGER
			count 2
			range '0 - 192'
			dbmin -9600
			dbmax 0
			dbvalue.0 0
			dbvalue.1 0
		}
	}
	control.2 {
		iface MIXER
		name 'Capture ZC Switch'
		value false
		comment {
			access 'read write'
